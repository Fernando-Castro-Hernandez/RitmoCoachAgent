# Copia este archivo a .env y rellena los valores.
# .env NUNCA se versiona — está en .gitignore.

# ─── Base de datos ────────────────────────────────────────────────────
DB_PASSWORD=cambia_esto_en_local

# ─── AWS / Bedrock ────────────────────────────────────────────────────
# En local: se usa tu perfil de ~/.aws/credentials.
# En producción: rol IAM de instancia. NUNCA claves estáticas aquí.
AWS_REGION=us-east-1

# Modelo de voz. Se deja como variable porque la cuenta puede no tener
# cuota para Nova 2 Sonic (ver ADR 0002). Respaldo verificado:
#   amazon.nova-sonic-v1:0     → LEGACY, 20 concurrentes, español OK
#   amazon.nova-2-sonic-v1:0   → preferido, requiere cuota > 0
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=Lupe

# ─── n8n ──────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=genera_una_cadena_larga_aleatoria

# ─── Telegram (tarea E1) ──────────────────────────────────────────────
# Se obtiene hablando con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Observabilidad (tarea E3) ────────────────────────────────────────
# Plan gratuito de Langfuse Cloud: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Despliegue (tarea F1) ────────────────────────────────────────────
# En local déjalo en localhost: el navegador trata localhost como contexto
# seguro, así que el micrófono funciona sin certificado.
SITE_ADDRESS=localhost
