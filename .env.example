# Copia este archivo a .env y rellena los valores.
# .env NUNCA se versiona — está en .gitignore.

# ─── Base de datos ────────────────────────────────────────────────────
DB_PASSWORD=cambia_esto_en_local

# ─── AWS / Bedrock ────────────────────────────────────────────────────
# En local: se usa tu perfil de ~/.aws/credentials.
# En producción: rol IAM de instancia. NUNCA claves estáticas aquí.
AWS_REGION=us-east-1

# Modelo de voz. Ambos verificados el 15-ago-2026 (ADR 0002):
#   amazon.nova-2-sonic-v1:0   → en uso
#   amazon.nova-sonic-v1:0     → respaldo, también abre stream
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0

# OJO: el voiceId va en MINÚSCULAS. La documentación muestra «Carlos» pero la
# API responde ValidationException. Válidos: carlos, lupe, tiffany, matthew.
NOVA_VOICE_ID=carlos

# ─── Visión · API directa de Anthropic (ADR 0014) ─────────────────────
# La ruta de visión NO pasa por Bedrock. Multi-nube a propósito: en la cuenta
# de AWS los seis modelos con visión tenían la cuota diaria en 0. La voz sí se
# queda en Bedrock, porque Anthropic no tiene streaming bidireccional de voz.
#
# Se saca de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# OJO: Claude 3.5 Haiku NO acepta imágenes. El Haiku que sí las acepta es el
# 4.5. Lista separada por comas, en orden de preferencia.
VISION_MODEL_CHAIN=claude-haiku-4-5-20251001

# ─── Guardrail de Bedrock (ADR 0013) ──────────────────────────────────
# No aplica inline al streaming bidireccional; se usa vía ApplyGuardrail
# sobre las transcripciones, fuera de la ruta de latencia.
BEDROCK_GUARDRAIL_ID=g4hhzrmtxbbo
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ─── n8n ──────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=genera_una_cadena_larga_aleatoria

# ─── Telegram (tarea E1) ──────────────────────────────────────────────
# Se obtiene hablando con @BotFather en Telegram. El USERNAME va sin @ y es el
# que termina en «bot»: es lo que construye el enlace t.me/<bot>?start=<token>.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secreto compartido del webhook. Inventado por nosotros, no lo da BotFather:
# se manda en setWebhook y Telegram lo devuelve en cada petición. Sin él, el
# endpoint responde 503 en vez de aceptar a cualquiera — vincula chats y es
# público, así que no puede caer abierto por una variable olvidada.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ─── Automatización · n8n (tarea E2) ──────────────────────────────────
# Llave con la que n8n pregunta a quién le toca un aviso. Esas respuestas
# llevan datos de salud de personas concretas, así que sin llave el endpoint
# cierra (503) en vez de caer abierto. El mismo valor va en la variable
# RITMO_AUTOMATION_KEY de la instancia de n8n.
#   openssl rand -hex 32
AUTOMATION_API_KEY=

# ─── Cuentas · JWT (cambio de alcance, Fase F) ────────────────────────
# Con lo que se firman los tokens de sesión. SIN ESTO la API arranca igual
# pero genera un secreto de proceso: reiniciar cierra la sesión de todo el
# mundo. Es a propósito — un secreto por defecto significa que cualquiera que
# lea el repositorio puede firmarse un token de cualquier usuario.
#   openssl rand -hex 32
JWT_SECRET=

# ─── Observabilidad (tarea E3) ────────────────────────────────────────
# Plan gratuito de Langfuse Cloud: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Despliegue (tarea F1) ────────────────────────────────────────────
# En local déjalo en localhost: el navegador trata localhost como contexto
# seguro, así que el micrófono funciona sin certificado.
SITE_ADDRESS=localhost
